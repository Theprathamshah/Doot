# Doot Configuration (.env)
# Copy to .env and chmod 600 .env

DOOT_ENV=dev
DOOT_DATA_DIR=./data
DOOT_DB_PATH=./data/doot.db

# LLM (Gemini API primary — zero local model downloads)
DOOT_LLM_PROVIDER=gemini
DOOT_GEMINI_API_KEY=
DOOT_GEMINI_MODEL=gemini-2.5-flash

# Search Dorking (Phase 2)
DOOT_SEARCH_PROVIDER=serper
DOOT_SERPER_API_KEY=
DOOT_BRAVE_API_KEY=
DOOT_TAVILY_API_KEY=

# Optional One-Way Alerts (Phase 4)
DOOT_NOTIFY_METHOD=macos
DOOT_NOTIFY_WEBHOOK_URL=

# Profile & Safety Guardrails
DOOT_PROFILE_VERSION=v1
DOOT_DAILY_APPLY_CAP=15
DOOT_PER_COMPANY_CAP=2
DOOT_MIN_DIGEST_SCORE=4
DOOT_DRY_RUN=true
